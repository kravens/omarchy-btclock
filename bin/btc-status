#!/usr/bin/bash
#
# btc-status - print one bounded JSON line describing the Bitcoin network.
#
# Writes no files and keeps no state: every invocation fetches, validates and
# prints to stdout. The origins come from a closed set, there are no credentials
# of any kind, and nothing here reads user configuration: the one option that
# does arrive from outside, --providers, is matched against that set below.
# Instances are tried in the order given, so a network that cannot reach one of
# them still gets a working widget from the next. --bitaxe names a miner on the
# local network; it is validated as a bare host[:port] and only ever asked for
# one fixed path.

set -uo pipefail
export LC_ALL=C

readonly CURL=/usr/bin/curl
readonly JQ=/usr/bin/jq
readonly HEAD=/usr/bin/head

# Producer-side ceiling. Each response is capped while streaming and then
# rejected by length, so an overlong body fails rather than being truncated
# into something that still parses.
readonly MAX=65536

# Public mempool instances that serve the same API, in the order they are tried.
# The first is the project's own instance and the widget's default preference;
# the mirror is listed because some networks cannot reach a given origin at all,
# which is the whole difference between a working widget and a blank one.
readonly PROVIDERS="mempool.space mempool.emzy.de"

# The caller kills this process at 30s, so stop starting new attempts well before
# that: an unreachable origin must not spend the whole budget and leave the next
# one untried.
readonly DEADLINE=20

readonly KRAKEN=https://api.kraken.com

# Set only from a validated --bitaxe value. AxeOS serves plain HTTP on the LAN.
BITAXE=

fail() {
  printf '{"ok":false}\n'
  exit 1
}

# The instance order is the only argument this script accepts, and it is the only
# value that ends up inside a URL it has not already seen. With no argument every
# instance is tried, in the order above - the same list the widget sends - so the
# script on its own fails over exactly like the widget does.
order=${PROVIDERS// /,}
while [ $# -gt 0 ]; do
  case ${1:-} in
  --providers)
    [ $# -ge 2 ] || fail
    order=$2
    shift 2
    ;;
  --bitaxe)
    [ $# -ge 2 ] || fail
    # A bare hostname or IPv4 address with an optional port: no scheme, no
    # userinfo, no path, so nothing but the fixed path below can be requested.
    [[ $2 =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,252}(:[0-9]{1,5})?$ ]] || fail
    BITAXE="http://$2"
    shift 2
    ;;
  *) fail ;;
  esac
done

IFS=, read -r -a requested <<<"$order"

# Bounded GET. The origin is not fixed down here - MEMPOOL is set per loop
# iteration - so what bounds the request is the closed-set match on the requested
# providers above: $MEMPOOL can only ever be one of those names. $KRAKEN is a
# constant. No -L, so a redirect is a failure rather than a fetch from somewhere
# else, and the proto flag pins the request and any redirect to https - except
# the one fixed Bitaxe URL, which is http because that is all AxeOS speaks.
fetch() {
  local url=$1 proto='=https' connect=5
  case $url in
  "$MEMPOOL"/* | "$KRAKEN"/*) ;;
  "$BITAXE/api/system/info")
    [ -n "$BITAXE" ] || return 1
    proto='=http'
    connect=3
    ;;
  *) return 1 ;;
  esac
  "$CURL" -q -sS --fail \
    --proto "$proto" --proto-redir "$proto" \
    --connect-timeout "$connect" --max-time 10 \
    --max-filesize "$MAX" --noproxy '*' \
    -- "$url" |
    "$HEAD" -c $((MAX + 1))
}

# Fetch, reject anything that reached the cap, and reject anything that is not
# well-formed JSON before it can reach the assembly step.
get_json() {
  local out
  out=$(fetch "$1") || return 1
  [ ${#out} -le "$MAX" ] || return 1
  printf '%s' "$out" | "$JQ" -e . >/dev/null 2>&1 || return 1
  printf '%s' "$out"
}

# Each name is matched against the closed set before any URL is built from it, so
# no host, port, path or scheme can be smuggled in from configuration. An unknown
# name is skipped rather than failing the run: one typo in a list of fallbacks
# should not cost the widget every instance it has. A list with nothing valid
# left is a malformed request, and fails outright.
#
# The tip height is the reachability probe. The first instance to answer it
# supplies the rest of the document, and no instance is asked twice.
MEMPOOL=
winner=
fees=null
prices=null
projected=null
block=null
seen=" "
valid=0
for provider in "${requested[@]}"; do
  provider=${provider//[[:space:]]/}
  case " $PROVIDERS " in
  *" $provider "*) ;;
  *) continue ;;
  esac
  valid=1
  case $seen in
  *" $provider "*) continue ;;
  esac
  seen="$seen$provider "
  # Out of time: better a fast, honest failure than a process the caller has to
  # kill after it has already given up waiting for the answer. Nothing has
  # answered yet, or this loop would already have broken out.
  [ "$SECONDS" -lt "$DEADLINE" ] || break

  MEMPOOL="https://$provider"
  height=$(fetch "$MEMPOOL/api/blocks/tip/height") || continue
  # Matched exactly, and never handed to bash arithmetic: inside $(( )) bash
  # would evaluate the contents of the value a second time.
  [[ $height =~ ^[0-9]{1,12}$ ]] || continue

  # The budget covers these too, not only the start of the next instance: an
  # instance that answers slowly must not be able to spend the whole allowance
  # and be killed by the caller mid-answer. What is already in hand is printed,
  # with whatever ran out of time left null.
  [ "$SECONDS" -lt "$DEADLINE" ] && fees=$(get_json "$MEMPOOL/api/v1/fees/recommended") || fees=null
  [ "$SECONDS" -lt "$DEADLINE" ] && prices=$(get_json "$MEMPOOL/api/v1/prices") || prices=null
  [ "$SECONDS" -lt "$DEADLINE" ] && projected=$(get_json "$MEMPOOL/api/v1/fees/mempool-blocks") || projected=null
  # The tip block's own details, for the new-block notification. The hash is
  # matched exactly before it becomes part of a path.
  block=null
  if [ "$SECONDS" -lt "$DEADLINE" ] && hash=$(fetch "$MEMPOOL/api/blocks/tip/hash") &&
    [[ $hash =~ ^[0-9a-f]{64}$ ]] && [ "$SECONDS" -lt "$DEADLINE" ]; then
    block=$(get_json "$MEMPOOL/api/v1/block/$hash") || block=null
  fi
  winner=$provider
  break
done

[ "$valid" = 1 ] || fail
# Set only once an instance has actually answered, so it can never be read as
# success by a run that was still waiting for its first reply when time ran out.
[ -n "$winner" ] || fail

# Kraken is the fallback price feed the BTClock firmware itself uses. USD only.
# The same budget applies: there is no point starting a fallback the caller is
# about to stop waiting for.
if [ "$prices" = null ] && [ "$SECONDS" -lt "$DEADLINE" ]; then
  kraken=$(get_json "$KRAKEN/0/public/Ticker?pair=XBTUSD") || kraken=null
  if [ "$kraken" != null ]; then
    prices=$(printf '%s' "$kraken" |
      "$JQ" -c '{USD: (.result.XXBTZUSD.c[0] | tonumber)}' 2>/dev/null) || prices=null
    [ -n "$prices" ] || prices=null
  fi
fi

# The miner is optional and independent: an unreachable Bitaxe costs its own
# screens, never the network data above.
miner=null
if [ -n "$BITAXE" ] && [ "$SECONDS" -lt "$DEADLINE" ]; then
  miner=$(get_json "$BITAXE/api/system/info") || miner=null
fi

# Every value is passed as validated JSON, never interpolated into the program.
# The currency map is filtered to three-letter keys holding finite positive
# numbers and capped in cardinality, so a hostile response cannot grow the
# document the widget then models.
"$JQ" -cn \
  --argjson height "$height" \
  --argjson fees "$fees" \
  --argjson prices "$prices" \
  --argjson projected "$projected" \
  --argjson block "$block" \
  --argjson miner "$miner" \
  --arg provider "$winner" \
  '
  def fee($v):
    if ($v | type) == "number" and $v >= 0 and $v <= 100000
    then ($v | floor) else 0 end;

  def num($v; $hi):
    if ($v | type) == "number" and $v >= 0 and $v <= $hi then $v else null end;

  # AxeOS used to report bestDiff as a string such as "4.29G"; newer firmware
  # sends a plain number. Both become a number, anything else null.
  def difficulty($v):
    if ($v | type) == "number" then num($v; 1e21)
    elif ($v | type) == "string" then
      ($v | capture("^(?<n>[0-9]{1,15}(\\.[0-9]{1,6})?) ?(?<u>[kKMGTP]?)$")?
        | (.n | tonumber) * ({"": 1, k: 1e3, K: 1e3, M: 1e6, G: 1e9, T: 1e12, P: 1e15}[.u]))
      // null
    else null end;

  ( $prices
    | if type == "object" then
        to_entries
        | map(select(
            (.key | test("^[A-Z]{3}$"))
            and (.value | type) == "number"
            and .value > 0
            and .value < 1e12))
        | .[0:10]
        | from_entries
      else {} end
  ) as $p
  | {
      height: $height,
      prices: $p,
      usd:  ($p.USD // 0),
      low:  fee($fees.economyFee),
      med:  fee($fees.halfHourFee),
      high: fee($fees.fastestFee),
      next: (if ($projected | type) == "array" and ($projected | length) > 0
             then num($projected[0].medianFee; 100000) else null end),
      block: (if ($block | type) == "object" and num($block.height; 1e9) != null then {
                height: ($block.height | floor),
                tx: (num($block.tx_count; 1e7) // 0 | floor),
                median: num($block.extras.medianFee; 100000),
                pool: (($block.extras.pool.name // "") | tostring
                       | gsub("[^A-Za-z0-9 .+_-]"; "") | .[0:32])
              } else null end),
      bitaxe: (if ($miner | type) == "object" and num($miner.hashRate; 1e9) != null then {
                 hash: $miner.hashRate,
                 best: difficulty($miner.bestDiff)
               } else null end),
      provider: $provider,
      ok:   (($p | length) > 0)
    }
  ' || fail
